+bool llama_context::set_dory_active_loops(uint32_t loops) {
+    if (model.arch != LLM_ARCH_DORY || loops < 1 || loops > 4) return false;
+    const auto * dory = dynamic_cast<const llama_model_dory *>(&model);
+    if (!dory || dory->n_loops != 4 || dory->recurrent_kv_cache_mode != "last_loop") return false;
+    synchronize();
+    cparams.dory_active_loops = loops;
+    return true;
+}
